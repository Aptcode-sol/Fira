# Admin dashboard configuration.
#
# Copy to `.env` on the server BEFORE running `npm run build` - Vite inlines
# VITE_* variables at build time, so setting this afterwards has no effect until
# you rebuild.
#
# Must point at the /admin prefix; the login call derives the main API base by
# stripping it, so https://api.letsfira.com/api/auth/login is reached correctly.

VITE_API_BASE_URL=https://api.letsfira.com/api/admin

# Set to 'true' to show dev-mode credential hints on the login page.
# Vite tree-shakes the block from production builds when this is unset or not 'true'.
VITE_DEV_MODE=false

# --- Sentry (APM & Error Tracking) ---
# Leave empty to disable Sentry entirely (no-op).
VITE_SENTRY_DSN=
