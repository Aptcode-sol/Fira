# ============================================================
# FIRA Client Environment Variables
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# IMPORTANT: client/.env was previously committed to git history.
# To purge it from all past commits, run (requires git-filter-repo):
#
#   git filter-repo --invert-paths --path client/.env
#
# Then force-push to remote. Rotate any exposed secrets afterward.
# ============================================================

# Base URL for the API server, including the /api prefix and no trailing slash.
# Optional: src/lib/siteConfig.ts falls back to http://localhost:5000/api in
# development and https://api.letsfira.com/api in production builds, so a build
# that never receives this variable still points at a real backend.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# VAPID public key for web push notifications
# Must match VAPID_PUBLIC_KEY in server/.env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# --- Sentry (APM & Error Tracking) ---
# Leave empty to disable Sentry entirely (no-op).
NEXT_PUBLIC_SENTRY_DSN=
